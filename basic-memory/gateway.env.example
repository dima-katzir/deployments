# Public HTTPS origin of the MCP endpoint.
PUBLIC_BASE_URL=https://basic-memory.example.com

# Numeric GitHub account ID permitted to authenticate.
EXPECTED_GITHUB_USER_ID=REPLACE_WITH_ACCOUNT_ID

# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_SECRET

# Generate and store these only on the host.
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
JWT_SIGNING_KEY=REPLACE_WITH_PRIVATE_SIGNING_KEY
