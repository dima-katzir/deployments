dktzr-life-os.duckdns.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8101 {
		flush_interval -1
	}
}

dktzr-memory.duckdns.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8201 {
		flush_interval -1
	}
}
